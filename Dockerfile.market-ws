FROM ubuntu:24.04 AS build

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      build-essential \
      cmake \
      ninja-build \
      libboost-all-dev \
      libssl-dev \
      libsqlite3-dev \
      zlib1g-dev \
      ca-certificates && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /src

COPY CMakeLists.txt .
COPY include ./include
COPY src ./src
COPY apps ./apps
COPY tests ./tests
COPY benchmarks ./benchmarks

RUN cmake \
      -S . \
      -B build \
      -G Ninja \
      -DCMAKE_BUILD_TYPE=Release && \
    cmake --build build \
      --target minimatch_live_market_ws \
      -j 2

FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      libboost-system1.83.0 \
      libssl3 \
      libsqlite3-0 \
      zlib1g \
      ca-certificates && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=build \
  /src/build/minimatch_live_market_ws \
  /app/minimatch_live_market_ws

CMD ["/app/minimatch_live_market_ws"]
